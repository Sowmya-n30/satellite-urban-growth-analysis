# ============================================================
# Environment Variables - Copy to .env and fill in values
# ============================================================

# Google Earth Engine Service Account (optional - for server deployments)
# Leave blank if using interactive authentication (ee.Authenticate())
GEE_SERVICE_ACCOUNT=
GEE_SERVICE_ACCOUNT_KEY_PATH=

# Google Drive folder for GEE exports
GEE_DRIVE_FOLDER=vijayawada_gee

# Data paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
EXPORTS_DIR=data/exports

# Model paths
CHECKPOINT_DIR=checkpoints
LOG_DIR=logs
RESULTS_DIR=results

# Training device (cuda / cpu / mps)
DEVICE=cuda

# Experiment tracking (optional)
MLFLOW_TRACKING_URI=
WANDB_API_KEY=
WANDB_PROJECT=vijayawada-urban-growth

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
